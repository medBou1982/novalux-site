# --- Base de données ---
DATABASE_URL=postgres://novalux:novalux@localhost:5432/novalux

# --- Serveur ---
PORT=4000
# URL publique du site (utilisée pour les retours de paiement Konnect)
PUBLIC_URL=http://localhost:5175
# URL publique de l'API (utilisée pour le webhook Konnect)
API_URL=http://localhost:4000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5175

# Secret de signature des sessions (mettre une longue valeur aléatoire en production)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Compte admin créé par `npm run db:seed` s'il n'existe pas
ADMIN_EMAIL=admin@novalux.com.tn
ADMIN_PASSWORD=ChangeMoi2026!

# --- Paiement en ligne Konnect (https://konnect.network) ---
# Laisser KONNECT_API_KEY vide = mode simulé (paiement de démonstration, sans argent réel)
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# sandbox : https://api.sandbox.konnect.network/api/v2   production : https://api.konnect.network/api/v2
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
